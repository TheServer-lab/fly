$ docs/architecture.md §7 roadmap step 4: coll/board literals (§11/§12),
$ indexing/slicing (§13/§14), and the §15 collection/text operations.

items = ["A", "B", "C"]
show(items[0])
show(items[1:3])

attach(items, "D")
show(items)
show(count(items))

place(items, 1, "X")
show(items)

removed = erase(items, 0)
show(removed)
show(items)

show(seek(items, "X"))
show(has(items, "nope"))

parts = ["one", "two", "three"]
show(bind(parts, ", "))

pieces = sever("a-b-c", "-")
show(pieces)

name = "RICK"
show(name[1:4])
show(name[:3])
show(name[2:])
show(cut("  padded  "))
show(raise("shout"))
show(lower("QUIET"))

people = {
    "Rick": 18,
    "Bob": 25
}
show(people["Rick"])
show(has(people, "Bob"))
show(count(people))
place(people, "Morty", 14)
show(people["Morty"])
erase(people, "Bob")
show(has(people, "Bob"))
show(count(people))

position = seek(items, "Nobody")
if position == EMP {
    show("Not found.")
}
